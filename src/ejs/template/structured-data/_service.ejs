        "provider": {
          "@id": "<%- common.url %>#organization"
        },
        "areaServed": "JP",
        "url": "<%- common.url %>service/#web"
      },
      {
        "@type": "Service",
        "@id": "<%- common.url %>service/#system-service",
        "name": "システム開発",
        "description": "CMSやメールフォーム、新着情報、ショッピングカートなど、更新しやすさを重視したシステム開発。",
        "provider": {
          "@id": "<%- common.url %>#organization"
        },
        "areaServed": "JP",
        "url": "<%- common.url %>service/#system"
      },
      {
        "@type": "Service",
        "@id": "<%- common.url %>service/#promotion-service",
        "name": "プロモーション",
        "description": "SEO対策、リスティング広告、DSP広告など集客を目的としたWEBプロモーション支援。",

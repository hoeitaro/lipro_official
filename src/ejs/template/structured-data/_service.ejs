          "addressRegion": "東京都",
          "addressLocality": "港区",
          "streetAddress": "港南2-15-1 品川インターシティA棟28F",
          "addressCountry": "JP"
        }
      },
      {
        "@type": "WebSite",
        "@id": "<%- common.url %>#website",
        "url": "<%- common.url %>",
        "name": "宝永企画｜東京のホームページ制作会社・WEB制作会社",
        "publisher": {
          "@id": "<%- common.url %>#organization"
        },
        "inLanguage": "ja-JP"
      },
      {
        "@type": "WebPage",
        "@id": "<%- common.url %>service/#webpage",
        "url": "<%- common.url %>service/",
        "name": "事業内容｜WEBサイト制作・システム開発・プロモーション",
        "description": "宝永企画の事業内容ページ。WEBサイト制作、システム開発、SEO・広告運用などのプロモーションまでワンストップで対応します。",
        "isPartOf": {
          "@id": "<%- common.url %>#website"
        },
        "about": {
          "@id": "<%- common.url %>#organization"
        },
        "inLanguage": "ja-JP",
        "breadcrumb": {
          "@id": "<%- common.url %>service/#breadcrumb"
        }
      },
      {
        "@type": "BreadcrumbList",
        "@id": "<%- common.url %>service/#breadcrumb",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "ホーム",
            "item": "<%- common.url %>"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "事業内容",
            "item": "<%- common.url %>service/"
          }
        ]
      },
      {
        "@type": "Service",
        "@id": "<%- common.url %>service/#web-service",
        "name": "WEBサイト制作",

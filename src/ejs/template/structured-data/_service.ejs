<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "<%- common.url %>#organization",
        "name": "<%- common.name %>",
        "url": "<%- common.url %>",
        "logo": "<%- common.url %>assets/images/logo.svg",

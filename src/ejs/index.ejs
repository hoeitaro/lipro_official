<% const jsonData = require('./data.json') %>
<!-- サイトバージョン -->
<% const ver = "20251125_0" %>
<!DOCTYPE html>
<html lang="ja">
  <head>
		<!-- head -->
    <%- include('./template/common/_head', {common: jsonData.common, current: jsonData.top}); %>
    <!-- stractured-data -->
    <!-- <%- include('./template/structured-data/_top', {common: jsonData.common, current: jsonData.top}); %> -->
  </head>

  <body>
    <!-- loader -->
    <%- include('./template/common/_loader'); %>
		
    <div class="l-contents">
      <!-- header -->
      <%- include('./template/common/_header', {path: "/", directory: "index", common: jsonData.common}); %>
      <main class="l-main" data-page-loaded>
        <section class="p-top-about" id="about" data-page-loaded>
					<div class="container">
						<h2 class="p-top-about__heading" data-display="1">常識を打ち破れ。</h2>
						<p class="p-top-about__en" data-display="1">Break the mold!</p>
						<div class="p-top-about__text" data-display="2">
							<p>わたしたちの行動や活動がほんの少しでも<br>世界の1人でも幸せにできることを信じて。</p>
						</div>

						<a href="#service" class="p-top-about__scrollDown">
							<img
								src="<%- jsonData.common.path %>assets/images/top/scroll.svg"
								width="48"
								height="48"
								alt=""
							/>
						</a>
					</div>

					<div class="p-top-about__bg" data-display="4">
						<picture>
							<source
								type="image/webp"
								srcset="<%- jsonData.common.path %>assets/images/top/bg.webp"
							/>
							<img
								src="<%- jsonData.common.path %>assets/images/top/bg.png"
								width="919"
								height="799"
								alt=""
								fetchpriority="high"
							/>
						</picture>
					</div>
        </section>

				<section class="p-top-service" id="service">
					<div class="container">
							<hgroup class="c-heading" data-page="top">
								<h2 class="heading" data-animation="heading"><span>事業内容</span></h2>
								<p lang="en" data-animation="split-text">Service</p>
							</hgroup>

							<div class="p-top-service__items">
								<article class="p-top-service-item" data-animation="fade-in-up">
									<h3 class="p-top-service-item__heading"><span>WEBサイト制作</span></h3>
									<p class="p-top-service-item__text">大型ポータルサイト、ECサイトやコーポレートサイトなどのCMS構築から、WEBサイトの新規立ち上げやデザイン作成・サイトリニューアルを始めとしたページ制作まで、幅広く柔軟に対応しております。</p>
									<picture class="p-top-service-item__img">
										<source
											type="image/webp"
											srcset="<%- jsonData.common.path %>assets/images/top/service_web.webp"
										/>
										<img
											src="<%- jsonData.common.path %>assets/images/top/service_web.png"
											width="270"
											height="284"
											alt=""
											loading="lazy"
										/>
									</picture>
								</article>
								<article class="p-top-service-item" data-animation="fade-in-up">
									<h3 class="p-top-service-item__heading"><span>システム開発</span></h3>
									<p class="p-top-service-item__text">検索システム、ポータルサイト、マッチングサイトやECサイトなど、WEBサイトを便利にするために必要なシステム開発・保守はもちろん、HTMLの知識がなくてもお客様ご自身の手で簡単にサイト更新を行えるシステム開発も承っております。</p>
									<picture class="p-top-service-item__img">
										<source
											type="image/webp"
											srcset="<%- jsonData.common.path %>assets/images/top/service_system.webp"
										/>
										<img
											src="<%- jsonData.common.path %>assets/images/top/service_system.png"
											width="270"
											height="284"
											alt=""
											loading="lazy"
										/>
									</picture>
								</article>
								<article class="p-top-service-item" data-animation="fade-in-up">
									<h3 class="p-top-service-item__heading"><span>プロモーション</span></h3>
									<p class="p-top-service-item__text">検索エンジン最適化(SEO)やリスティング広告(SEM)によるプロモーション、アクセス解析の分析、広告代理業など、広告・宣伝のサポートも行なっております。</p>
									<picture class="p-top-service-item__img">
										<source
											type="image/webp"
											srcset="<%- jsonData.common.path %>assets/images/top/service_promotion.webp"
										/>
										<img
											src="<%- jsonData.common.path %>assets/images/top/service_promotion.png"
											width="270"
											height="284"
											alt=""
											loading="lazy"
										/>
									</picture>
								</article>
								<article class="p-top-service-item" data-animation="fade-in-up">
									<h3 class="p-top-service-item__heading"><span>プロダクション事業</span></h3>
									<p class="p-top-service-item__text">グラビアモデルや撮影会モデルをはじめとする、タレントマネジメントとプロモーションを軸としたプロダクション事業行っております。</p>
									<picture class="p-top-service-item__img">
										<source
											type="image/webp"
											srcset="<%- jsonData.common.path %>assets/images/top/service_production.webp"
										/>
										<img
											src="<%- jsonData.common.path %>assets/images/top/service_production.png"
											width="270"
											height="284"
											alt=""
											loading="lazy"
										/>
									</picture>
								</article>
							</div>

					</div>
					
					<div class="circle" data-circle="6" data-circlePosition="1"></div>
				</section>

				<section class="p-top-company" id="company">
					<div class="container">
						<hgroup class="c-heading" data-page="top">
							<h2 class="heading" data-animation="heading"><span>会社概要</span></h2>
							<p lang="en" data-animation="split-text">Company</p>
						</hgroup>

						<dl class="p-top-company__list c-list">
							<div class="c-list__item">
								<dt class="c-list__term">名称</dt>
								<dd class="c-list__description">
									<p>合同会社リップロ</p>
								</dd>
							</div>
							<div class="c-list__item">
								<dt class="c-list__term">所在地</dt>
								<dd class="c-list__description">
									<p>【本社】<br>〒231-0015<br>神奈川県横浜市中区尾上町6丁目87-1</p>
									<p>【渋谷支社】<br>〒150-0043<br>東京都渋谷区道玄坂1-19-6 津田ソシアルビル2F</p>
								</dd>
							</div>
							<div class="c-list__item">
								<dt class="c-list__term">事業内容</dt>
								<dd class="c-list__description">
									<p>WEBコンサルティング<br>デザイン全般<br>広告代理店業<br>タレントマネジメント・プロダクション事業</p>
								</dd>
							</div>
							<div class="c-list__item">
								<dt class="c-list__term">設立日</dt>
								<dd class="c-list__description">
									<p>令和2年8月21日</p>
								</dd>
							</div>
							<div class="c-list__item">
								<dt class="c-list__term">取引銀行</dt>
								<dd class="c-list__description">
									<p>三井住友銀行</p>
								</dd>
							</div>
							<div class="c-list__item">
								<dt class="c-list__term">電話番号</dt>
								<dd class="c-list__description">
									<p>03-6416-3369</p>
								</dd>
							</div>
						</dl>
					</div>
				</section>

				<section class="p-top-contact" id="contact">
					<div class="container">
						<hgroup class="c-heading" data-page="top">
							<h2 class="heading" data-animation="heading"><span>お問い合わせ・お申し込み・ご相談</span></h2>
							<p lang="en" data-animation="split-text">Contact</p>
						</hgroup>

						<p class="p-top-contact__lead">制作のお申し込み・ご相談、モデルの募集についてのお問い合わせもこちらのフォームより承っております。<br>下記フォーム内容をご記入後、確認画面へお進みください。</p>

						<div class="p-top-contact__container">
							<form action="<%- jsonData.common.ssgform %>" method="post" data-ssg-form>
								<div style="display: none;"><input type="text" name="wana" /></div>

								<div class="form-input">

									<ul class="form-steps">
										<li class="form-steps__item is-current"><span>入力画面</span></li>
										<li class="form-steps__item">確認画面</li>
										<li class="form-steps__item">完了画面</li>
									</ul>
									
									<div class="p-top-contact__table c-lower-table">
										<div class="c-lower-table__item" data-vertical="center">
											<p class="c-lower-table__label"><label class="label" for="name">お名前</label><span class="required">必須</span></p>
											<div class="c-lower-table__content" data-space="none">
												<input class="input" id="name" name="お名前" required placeholder="お名前をご入力ください" autocomplete="name" data-field="name" />
											</div>
										</div>

										<div class="c-lower-table__item" data-vertical="center">
											<p class="c-lower-table__label"><label class="label" for="company">会社名</label></p>
											<div class="c-lower-table__content" data-space="none">
												<input class="input" id="company" name="会社名" placeholder="会社名をご入力ください" autocomplete="organization" data-field="company" />
											</div>
										</div>

										<div class="c-lower-table__item" data-vertical="center">
											<p class="c-lower-table__label"><label class="label" for="email">メールアドレス</label><span class="required">必須</span></p>
											<div class="c-lower-table__content" data-space="none">
												<input class="input" id="email" type="email" name="メールアドレス" required placeholder="メールアドレスをご入力ください" autocomplete="email" data-field="email">
											</div>
										</div>

										<div class="c-lower-table__item" data-vertical="center">
											<p class="c-lower-table__label"><label class="label" for="email_confirm">メールアドレス確認</label><span class="required">必須</span></p>
											<div class="c-lower-table__content" data-space="none">
												<input class="input" id="email_confirm" type="email" required placeholder="メールアドレスをご入力ください" autocomplete="email" data-field="email_confirm">
											</div>
										</div>

										<div class="c-lower-table__item" data-vertical="center">
											<p class="c-lower-table__label"><label class="label" for="tel">電話番号</label></p>
											<div class="c-lower-table__content" data-space="none">
												<input class="input" id="tel" name="電話番号" placeholder="電話番号をご入力ください" autocomplete="tel" data-field="tel" />
											</div>
										</div>

										<div class="c-lower-table__item">
											<p class="c-lower-table__label"><span class="label">件名</span><span class="required">必須</span></p>
											<div class="c-lower-table__content">
												<ul class="c-lower-table__radioList">
													<li>
														<label class="radio">
															<input type="radio" name="件名" value="WEBサイト制作・システム開発などのお申し込み" data-field="subject">
															WEBサイト制作・システム開発などのお申し込み
														</label>
													</li>
													<li>
														<label class="radio">
															<input type="radio" name="件名" value="モデルのご応募" data-field="subject">
															モデルのご応募
														</label>
													</li>
													<li>
														<label class="radio">
															<input type="radio" name="件名" value="質問" data-field="subject">
															質問
														</label>
													</li>
													<li>
														<label class="radio">
															<input type="radio" name="件名" value="ご意見・ご感想" data-field="subject">
															ご意見・ご感想
														</label>
													</li>
													<li>
														<label class="radio">
															<input type="radio" name="件名" value="その他" data-field="subject">
															その他
														</label>
													</li>
												</ul>
											</div>
										</div>

										<div class="c-lower-table__item">
											<p class="c-lower-table__label"><label class="label" for="message">お問い合わせ内容</label><span class="required">必須</span></p>
											<div class="c-lower-table__content" data-space="none">
												<textarea class="textarea input" id="message" name="お問い合わせ内容" rows="5" required placeholder="お問い合わせ内容をご入力ください" data-field="message"></textarea>
											</div>
										</div>


										<div class="c-lower-table__item" data-tableItem="single-column">
											<p class="p-top-contact__note">個人情報の取り扱いに関しては、<br class="u-md-none"><a href="/privacy/" target="_blank" rel="noopener noreferrer">プライバシーポリシー</a>をご確認下さい。</p>

											<button class="c-button" type="button" data-action="confirm"><span class="arrow c-arrow"></span>確認する</button>
										</div>

									</div>
								</div>

								<div class="form-conf">
									<ul class="form-steps">
										<li class="form-steps__item"><span>入力画面</span></li>
										<li class="form-steps__item is-current"><span>確認画面</span></li>
										<li class="form-steps__item"><span>完了画面</span></li>
									</ul>
									
									<div class="p-top-contact__table c-lower-table">
										<div class="c-lower-table__item" data-vertical="center">
											<p class="c-lower-table__label"><label class="label">お名前</label><span class="required">必須</span></p>
											<div class="c-lower-table__content" data-space="none">
												<p data-conf="name"></p>
											</div>
										</div>

										<div class="c-lower-table__item" data-vertical="center">
											<p class="c-lower-table__label"><label class="label">会社名</label></p>
											<div class="c-lower-table__content" data-space="none">
												<p data-conf="company"></p>
											</div>
										</div>

										<div class="c-lower-table__item" data-vertical="center">
											<p class="c-lower-table__label"><label class="label">メールアドレス</label><span class="required">必須</span></p>
											<div class="c-lower-table__content" data-space="none">
												<p data-conf="email"></p>
											</div>
										</div>

										<div class="c-lower-table__item" data-vertical="center">
											<p class="c-lower-table__label"><label class="label">電話番号</label></p>
											<div class="c-lower-table__content" data-space="none">
												<p data-conf="tel"></p>
											</div>
										</div>

										<div class="c-lower-table__item">
											<p class="c-lower-table__label"><span class="label">件名</span><span class="required">必須</span></p>
											<div class="c-lower-table__content">
												<p data-conf="subject"></p>
											</div>
										</div>

										<div class="c-lower-table__item">
											<p class="c-lower-table__label"><label class="label">お問い合わせ内容</label><span class="required">必須</span></p>
											<div class="c-lower-table__content" data-space="none">
												<p data-conf="message"></p>
											</div>
										</div>

										<div class="c-lower-table__item" data-tableItem="single-column" data-conf>
											<button class="c-button" type="submit" data-action="send"><span class="arrow c-arrow"></span>送信する</button>
											<button class="c-back" type="button" data-action="back"><span class="arrow c-arrow"></span>修正する</button>
										</div>

									</div>
								</div>
							</form>
						</div>
					</div>
					<div class="circle" data-circle="7" data-circlePosition="1"></div>
					<div class="circle" data-circle="8" data-circlePosition="1"></div>
					<div class="circle" data-circle="9" data-circlePosition="1"></div>
				</section>

				<!-- circles -->
				<%- include('./template/common/_circles', {path: "/", directory: "index"}); %>

      </main>
      <!-- footer -->
      <%- include('./template/common/_footer', {path: "/", directory: "index", common: jsonData.common}); %>
      <!-- drawer -->
      <%- include('./template/common/_drawer', {path: "/"}); %>
      <!-- svg -->
      <%- include('./template/common/_svg'); %>
    </div>
  </body>
</html>
